# Public values only. These are safe in the browser.
# Find them in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side secrets are NOT set here. They go in Supabase → Edge Functions → Secrets:
# ANTHROPIC_API_KEY, RESEND_API_KEY (SUPABASE_SERVICE_ROLE_KEY is provided automatically)
